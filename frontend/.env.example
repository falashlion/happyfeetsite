# Frontend environment — Next.js reads this automatically.
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time, so a
# change here needs a dev-server restart to take effect.

# Go API base URL (includes the /api/v1 prefix).
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Store contact details. Keep these in step with the STORE_* values in
# backend/.env.local — the number a customer taps on the site and the number
# printed in their confirmation email must match.
NEXT_PUBLIC_STORE_NAME=Happy Feet
NEXT_PUBLIC_STORE_WHATSAPP_NUMBER=237612345678
NEXT_PUBLIC_STORE_WHATSAPP_DISPLAY=+237 6 12 34 56 78
NEXT_PUBLIC_STORE_SUPPORT_EMAIL=care@happyfeet.cm
NEXT_PUBLIC_STORE_ADDRESS=Bonapriso, Douala, Cameroon
