# ══════════════════════════════════════════════════════════════════════════
# Production environment — lives at /opt/happyfeet/.env.prod ON THE SERVER ONLY.
#
# This file is never committed. Copy it to the server once, fill it in, and
# `chmod 600` it. The deploy workflow rewrites only the API_IMAGE and WEB_IMAGE
# lines and leaves everything else untouched.
#
#   scp deploy/.env.prod.example user@server:/opt/happyfeet/.env.prod
#   ssh user@server 'chmod 600 /opt/happyfeet/.env.prod && nano /opt/happyfeet/.env.prod'
# ══════════════════════════════════════════════════════════════════════════

# ── Managed by the deploy workflow — do not edit ──────────────────────────
API_IMAGE=
WEB_IMAGE=

# ── Domain & TLS ──────────────────────────────────────────────────────────
DOMAIN=example.com
ACME_EMAIL=you@example.com          # Let's Encrypt expiry notices

# ── Application ───────────────────────────────────────────────────────────
APP_ENV=production
APP_DEBUG=false
APP_VERSION=1.0.0
FRONTEND_URL=https://www.example.com

# ── Database ──────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
# Changing this after first boot does NOT change the existing database user;
# the volume must be recreated or the password altered in psql.
POSTGRES_PASSWORD=

# ── JWT — MUST be changed, minimum 32 characters ──────────────────────────
# Generate each separately: openssl rand -base64 48
# Rotating these invalidates every session; refresh tokens live 30 days.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=720h

# ── Store identity ────────────────────────────────────────────────────────
STORE_NAME=Happy Feet
STORE_OWNER_EMAIL=                  # receives every new-order alert
STORE_WHATSAPP_NUMBER=237612345678  # digits only, no "+"
STORE_WHATSAPP_DISPLAY=+237 6 12 34 56 78
STORE_SUPPORT_EMAIL=
STORE_ADDRESS=Bonapriso, Douala, Cameroon
STORE_HOURS=Mon–Sat, 08:00–20:00 WAT

# ── Email ─────────────────────────────────────────────────────────────────
# Gmail caps at ~500 recipients/day and is not built for transactional mail;
# a dedicated relay also gives you delivery logs and bounce handling.
#   Resend  3,000/month free   smtp.resend.com:587      user "resend"
#   Brevo     300/day free     smtp-relay.brevo.com:587
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=orders@example.com
SMTP_FROM_NAME=Happy Feet

# ── Google sign-in ────────────────────────────────────────────────────────
# The SAME client ID as development, with the production origin added to
# "Authorised JavaScript origins": https://www.example.com
GOOGLE_CLIENT_ID=

# ── Backups ───────────────────────────────────────────────────────────────
BACKUP_KEEP_DAYS=14
# Off-host copy. Cloudflare R2 gives 10 GB free with no egress charge.
# Leave blank to keep backups on the VM only (survives a bad deploy, not a
# lost machine).
S3_BACKUP_BUCKET=
S3_BACKUP_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Payment providers (currently unused — checkout is cash on delivery) ───
# Fill these in when you re-enable online payment in checkout step 3.
MTN_SUBSCRIPTION_KEY=
MTN_API_USER_ID=
MTN_API_KEY=
MTN_ENVIRONMENT=production
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_MERCHANT_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Image uploads (Cloudinary) ────────────────────────────────────────────────
# The browser uploads straight to Cloudinary; these only sign the request.
# CLOUDINARY_API_SECRET never leaves the server. Leave CLOUDINARY_CLOUD_NAME
# blank and image upload reports 503 instead of silently failing.
# Dashboard → Settings → API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=happyfeet
