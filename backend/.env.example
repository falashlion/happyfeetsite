# ══════════════════════════════════════════════════
# HappyFeet API — Environment Variables
# Copy to .env and fill in real values
# ══════════════════════════════════════════════════

# ── Application ───────────────────────────────────
APP_NAME=happyfeet-api
APP_ENV=development          # development | staging | production
APP_VERSION=1.0.0
APP_DEBUG=true
FRONTEND_URL=http://localhost:3000
CDN_URL=http://localhost:9000/happyfeet-media-dev

# ── HTTP Server ────────────────────────────────────
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=30s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=120s

# ── Database ───────────────────────────────────────
DATABASE_URL=postgres://happyfeet:happyfeet_dev_secret@localhost:5432/happyfeet?sslmode=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_CONN_MAX_LIFETIME=15m
DB_CONN_MAX_IDLE_TIME=5m

# ── Redis ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT (CHANGE IN PRODUCTION — min 32 chars) ─────
JWT_ACCESS_SECRET=CHANGE-ME-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=CHANGE-ME-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=720h

# ── AWS / MinIO ────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
S3_BUCKET=happyfeet-media-dev
S3_ENDPOINT=http://localhost:9000   # empty for real AWS
CLOUDFRONT_URL=http://localhost:9000/happyfeet-media-dev
S3_PRESIGN_EXPIRY=15m

# ── MTN MoMo ──────────────────────────────────────
MTN_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_SUBSCRIPTION_KEY=your-mtn-subscription-key
MTN_API_USER_ID=your-api-user-id
MTN_API_KEY=your-api-key
MTN_ENVIRONMENT=sandbox
MTN_WEBHOOK_SECRET=your-mtn-webhook-secret

# ── Orange Money ───────────────────────────────────
ORANGE_BASE_URL=https://api.orange.com
ORANGE_CLIENT_ID=your-client-id
ORANGE_CLIENT_SECRET=your-client-secret
ORANGE_COUNTRY_CODE=CM
ORANGE_MERCHANT_KEY=your-merchant-key
ORANGE_WEBHOOK_SECRET=your-webhook-secret
ORANGE_RETURN_URL=https://happyfeet.com/checkout/complete
ORANGE_CANCEL_URL=https://happyfeet.com/checkout/cancelled

# ── Stripe ─────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── SMTP ───────────────────────────────────────────
# Leave SMTP_HOST empty to switch transactional email off entirely; the API
# logs a warning at boot and every other feature keeps working.
#
# Local dev: Mailpit from compose.local.yml captures everything at :1025 and
# serves it at http://localhost:8025 — nothing leaves the machine.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@happyfeet.com
SMTP_FROM_NAME=Happy Feet

# Production, e.g. Gmail. Port 587 negotiates STARTTLS, 465 uses implicit TLS.
# Gmail needs an App Password (2-Step Verification must be on) — the account
# password will be rejected: https://myaccount.google.com/apppasswords
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USERNAME=you@gmail.com
#   SMTP_PASSWORD=<16-character app password>
#   SMTP_FROM=you@gmail.com

# ── Store identity ─────────────────────────────────
# Drives the order emails and the WhatsApp deep links inside them.
STORE_NAME=Happy Feet

# Receives a "new order" alert for every order placed. Unset = no alert.
STORE_OWNER_EMAIL=

# Digits only, international format, no "+" — this is what wa.me accepts.
STORE_WHATSAPP_NUMBER=237654904707
# Human-readable rendering shown in email and on the site.
STORE_WHATSAPP_DISPLAY=+237 6 54 90 47 07e

STORE_SUPPORT_EMAIL=care@happyfeet.cm
STORE_ADDRESS=Bonapriso, Douala, Cameroon
STORE_HOURS=Mon–Sat, 08:00–20:00 WAT

# ── Google sign-in ─────────────────────────────────
# OAuth 2.0 "Web application" Client ID from Google Cloud Console
# (APIs & Services → Credentials). The client *secret* is not needed: the
# storefront uses the ID-token flow, and the API verifies Google's signature.
#
# Authorised JavaScript origins must include every origin the storefront is
# served from, e.g. http://localhost:3000 in development.
#
# Unset = Google sign-in disabled; the button is hidden and the endpoint
# answers 503. Comma-separate several IDs if web and mobile clients share
# this API.
GOOGLE_CLIENT_ID=
